#cloud-config
# sovereign-os Ubuntu 26.04 LTS autoinstall — the Subiquity answer file.
#
# This is the Ubuntu counterpart of
# scripts/build/installer-cdd/profiles/default.preseed. It is NOT a preseed and
# cannot be: Ubuntu dropped debian-installer at 20.04 and Subiquity does not
# read debconf preseeds at all. Same intent, different mechanism.
#
# Installs Ubuntu 26.04 + KDE Plasma (kubuntu-desktop) + the custom znver5
# kernel + the sovereign-os cockpit onto the operator-selected disk.

autoinstall:
  version: 1

  # ── WHAT STAYS INTERACTIVE (deliberate) ───────────────────────────────────
  # `storage` and `identity` are NOT answered here, so Subiquity STOPS and asks.
  # This mirrors default.preseed, which deliberately preseeds neither the disk
  # pick nor the destructive write confirmations:
  #
  #   * storage  — an unattended installer repartitions whatever disk it picked.
  #     The Debian path once hardcoded "skip nvme0n1" on the assumption that
  #     nvme0n1 was the running OS; that assumption expired and the rule then
  #     selected exactly the disk it was written to protect. A device name is
  #     not an identity. The operator picks the target (2026-07-27).
  #
  #   * identity — passwords must never be baked into an image. The Debian
  #     preseed shipped `root-password sovereign` in cleartext inside every
  #     ISO, world-readable at /simple-cdd/default.preseed, which meant anyone
  #     holding the image knew the root password of every box built from it.
  #     SDD-015: secrets live in /etc/sovereign-os/*.env, never in tracked
  #     files. Subiquity prompts instead.
  interactive-sections:
    - storage
    - identity

  locale: en_US.UTF-8
  keyboard:
    layout: us

  # Offline by default — the ISO carries its own pool, same contract as the
  # d-i path. Subiquity tolerates a missing network; it must not block on one.
  network:
    version: 2
    ethernets:
      default:
        match:
          name: "en*"
        dhcp4: true
        optional: true

  apt:
    # Ubuntu components. `main` alone strands the GPU stack: the nvidia and
    # firmware packages live in restricted/multiverse, exactly as they live in
    # non-free/contrib on Debian.
    primary:
      - arches: [amd64]
        uri: http://archive.ubuntu.com/ubuntu
    fallback: offline-install

  # ── PACKAGES ──────────────────────────────────────────────────────────────
  # The list that ACTUALLY installs. Kept aligned with the Debian pkgsel/include
  # in default.preseed; the two differ only where the distros genuinely differ
  # (see scripts/build/lib/distro.sh):
  #   task-kde-desktop  -> kubuntu-desktop
  #   firmware-*  (4 pkgs, non-free-firmware) -> linux-firmware  (one, main)
  packages:
    # "standard system utilities" — Subiquity has no tasksel, so the
    # analogue is the seed metapackage. Without it an autoinstall lands a
    # minimal system missing what every ordinary Ubuntu has.
    - ubuntu-standard

    # AI/driver enablement: nvidia-driver-install.sh builds the module with
    # --dkms against the custom znver5 kernel, so dkms + a compiler must be
    # on the target. pip/venv carry the model toolchain. 26.04 ships native
    # CUDA/ROCm, which is precisely why this box runs it.
    - dkms
    - build-essential
    - pkg-config
    - python3-pip
    - python3-venv

    # THE DISPLAY DEVICE, not just the accelerator (operator decision
    # 2026-07-29). Ubuntu 26.04's Plasma is Wayland-only, so the desktop needs
    # a real DRM device; nomodeset — the Debian workaround — cannot provide one
    # and is fatal here. This driver is what makes nvidia-drm.modeset=1 in the
    # late-commands mean anything, and it is also what makes the RTX 5090
    # available for inference.
    #
    # -open is REQUIRED, not preferred: NVIDIA's proprietary kernel module does
    # not support Blackwell (GB202). The version tracks profiles/sain-01.yaml's
    # `driver: nvidia-570-open`, and is single-sourced through
    # distro_gpu_driver_package() in scripts/build/lib/distro.sh.
    #
    # Unlike Debian — whose trixie archive ships 550, predating Blackwell, and
    # so has to fetch a .run installer — Ubuntu 26.04 packages 570 through 595,
    # so this comes from the archive with dkms handling the custom znver5
    # kernel. verify-packages-exist.sh checks the name against the live archive
    # before the ISO is remastered.
    - nvidia-driver-570-open
    - python3-dev
    - ubuntu-drivers-common
    - kubuntu-desktop
    - sddm
    - konsole
    - dolphin
    - firefox
    - sudo
    - lvm2
    - grub-efi-amd64
    - efibootmgr
    - network-manager
    - python3
    - python3-yaml
    - python3-jsonschema
    - prometheus-node-exporter
    - curl
    - git
    - ca-certificates
    - nano
    - initramfs-tools
    - locales
    - console-setup
    - keyboard-configuration
    - systemd-resolved
    - netbase
    - iproute2
    - less
    - xterm
    - tmux
    - vim
    - bash-completion
    - man-db
    - pciutils
    - usbutils
    - nvme-cli
    - smartmontools
    - lshw
    - dmidecode
    - lm-sensors
    - htop
    - rsync
    - wget
    - file
    - tree
    - lsof
    - iputils-ping
    - bind9-dnsutils
    - ncdu
    - xserver-xorg-video-fbdev
    - xserver-xorg-video-vesa
    - amd64-microcode
    - linux-firmware
    - mokutil
    # Required by install-gui-dashboards.sh for every frontend; its absence
    # from the Debian lists killed the whole dashboards deploy (2026-07-28).
    - xdg-utils

  # Subiquity's own kernel for the INSTALLED system; the custom znver5
  # linux-image-6.12.0 is dpkg-installed from the ISO pool in late-commands and
  # pinned as the GRUB default there.
  updates: security
  shutdown: reboot

  late-commands:
    # ── 1. the sovereign payload from the ISO's own pool (offline) ──────────
    - mkdir -p /target/opt/sovereign-os /target/etc/sovereign-os
    - cp -a /cdrom/sovereign/pool/. /target/tmp/ 2>/dev/null || true
    - curtin in-target -- sh -c 'dpkg -i /tmp/sovereign-os-cockpit_*.deb 2>/dev/null || apt-get -f install -y || true'
    - curtin in-target -- sh -c 'dpkg -i /tmp/linux-image-6.12.0_*.deb /tmp/linux-headers-6.12.0_*.deb 2>/dev/null || apt-get -f install -y || true'

    # ── 2. KERNEL CMDLINE — write it EXPLICITLY. ───────────────────────────
    # Do NOT rely on an installer's "add kernel options" mechanism. The Debian
    # path set `d-i debian-installer/add-kernel-opts string nomodeset` and it
    # silently did nothing: grub-installer ran and left GRUB_CMDLINE_LINUX=""
    # (verified on the installed disk, 2026-07-28). The install then booted
    # fine, three times, to a black screen nobody could log into.
    #
    # /usr/lib/udev/rules.d/71-seat.rules tags a device `master-of-seat` in
    # exactly two ways on this hardware:
    #     rule 23/28  fb[0-9]  — but ONLY when IMPORT{cmdline}="nomodeset"
    #     rule 35     drm card[0-9]* — needs a KMS driver bound
    # Without a master-of-seat device logind reports CanGraphical=no and the
    # display manager waits forever for a graphical seat. There is no error, no
    # failed unit, and no Xorg.0.log — the machine is healthy and blank.
    #
    # UBUNTU TAKES RULE 35, NOT 23/28 — the opposite of the Debian path, and
    # this is deliberate (operator decision 2026-07-29).
    #
    # nomodeset is a DEBIAN-ONLY workaround and on Ubuntu it is FATAL. Debian's
    # plasma-workspace ships /usr/share/xsessions/plasmax11.desktop so Plasma
    # runs X11 on the framebuffer; Ubuntu 26.04's Plasma is WAYLAND-ONLY, with
    # /usr/share/xsessions/ EMPTY. Wayland needs a DRM device and nomodeset is
    # exactly what removes one, so nomodeset guarantees there is NO session the
    # display manager can start. Proven on a real disk: same install, nomodeset
    # stripped and nothing else changed, went from a blinking cursor to the
    # Kubuntu greeter (luma 1e-05 -> 0.076).
    #
    # So Ubuntu gets a REAL DRM device from the NVIDIA driver instead:
    # nvidia-drm.modeset=1 registers a DRM node, rule 35 tags card0, the
    # Wayland session starts — and the RTX 5090 is actually usable for
    # inference, which nomodeset precludes. On an AI box that was always the
    # better answer.
    #
    # THE TWO ARE MUTUALLY EXCLUSIVE. Never emit both: nomodeset stops the
    # driver binding, so the box falls back to framebuffer graphics and looks
    # like the driver failed to install.
    #
    # Single-sourced from distro_kernel_cmdline() in scripts/build/lib/distro.sh;
    # build.sh renders the profile's cmdline through it before this ships.
    - curtin in-target -- sh -c 'sed -i "s/^GRUB_CMDLINE_LINUX=.*/GRUB_CMDLINE_LINUX=\"nvidia-drm.modeset=1\"/" /etc/default/grub'
    - curtin in-target -- sh -c 'grep -q "^GRUB_CMDLINE_LINUX=" /etc/default/grub || echo "GRUB_CMDLINE_LINUX=\"nvidia-drm.modeset=1\"" >> /etc/default/grub'
    - curtin in-target -- sh -c 'sed -i "s/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=2/" /etc/default/grub'
    - curtin in-target -- sh -c 'update-grub || true'
    - curtin in-target -- sh -c 'update-initramfs -u -k all || true'

    # ── 3. pin the custom znver5 kernel as the GRUB default ────────────────
    # Ubuntu 26.04 ships a newer kernel than 6.12.0, and GRUB orders by version,
    # so without this the box boots the stock kernel. The stock one stays in the
    # menu as a fallback — which is the whole reason a bad custom kernel is
    # recoverable rather than a reinstall.
    - curtin in-target -- sh -c 'sh /opt/sovereign-os/scripts/install/set-grub-default-kernel.sh 6.12.0 || true'

    # ── 4. profile + cockpit ───────────────────────────────────────────────
    - curtin in-target -- sh -c 'echo sain-01 > /etc/sovereign-os/active-profile'
    - curtin in-target -- sh -c 'echo SOVEREIGN_OS_PROFILE=sain-01 > /etc/sovereign-os/active-profile.env'
    - curtin in-target -- sh -c 'sh /opt/sovereign-os/scripts/install/deploy-dashboards.sh || true'
    - curtin in-target -- sh -c 'sh /opt/sovereign-os/scripts/install/verify-installed-system.sh || true'
    # `systemctl enable sddm` is NOT enough. The Ubuntu DESKTOP ISO's base
    # install is GNOME, so display-manager.service still points at gdm3 — and
    # enable will not steal that alias from an existing owner. gdm3 wants a DRM
    # device for its Wayland greeter, which nomodeset removes, so the installed
    # system booted to a blinking cursor on black: the 2026-07-26 symptom,
    # reproduced exactly in a VM on 2026-07-29 with everything else correct.
    - curtin in-target -- sh -c 'sh /opt/sovereign-os/scripts/install/select-display-manager.sh sddm || systemctl enable sddm || true'

    # ── 5. prove the seat can actually go graphical ────────────────────────
    # The one check that would have caught the 2026-07-28 black screen before
    # the operator ever rebooted. It cannot run inside the installer (logind
    # there describes the LIVE session, not the target), so leave the evidence
    # on disk for the first boot to answer.
    # NOTE the quoting: a bare `WORD: word` inside an unquoted YAML scalar makes
    # the parser read the whole entry as a MAPPING, not a command string. This
    # line once said "SOVEREIGN WARNING: nomodeset missing …" and Subiquity would
    # have received a dict where it expects a command (caught by parsing the
    # user-data off the built ISO, 2026-07-29). Keep colons out of the message,
    # or quote the entire scalar.
    - curtin in-target -- sh -c 'grep -q "nvidia-drm.modeset=1" /boot/grub/grub.cfg || echo "SOVEREIGN WARNING - nvidia-drm.modeset=1 missing from grub.cfg, no DRM device, Wayland Plasma cannot start and sddm will hang with CanGraphical=no" > /var/log/sovereign-install-warning.log'
    # The inverse check. nomodeset reaching an Ubuntu install is not a
    # degradation, it is a total failure — Wayland-only Plasma has no session
    # without a DRM device. Leave the evidence and the one-line fix on disk.
    - curtin in-target -- sh -c '! grep -q nomodeset /boot/grub/grub.cfg || echo "SOVEREIGN WARNING - nomodeset is present on an Ubuntu install. It is FATAL here (Wayland-only Plasma, empty /usr/share/xsessions). Remove it from GRUB_CMDLINE_LINUX in /etc/default/grub and run update-grub." >> /var/log/sovereign-install-warning.log'
    # Prove the driver that provides the DRM device actually installed. If it
    # did not, nvidia-drm.modeset=1 is inert and the result is the same black
    # screen by a different route.
    # ── THE TWO THINGS A VM CANNOT TELL YOU ────────────────────────────────
    # Both produce an install that "succeeded" and a machine that is unusable,
    # and neither is visible until the operator is standing at the box.
    #
    # 1. NO NETWORK -> `fallback: offline-install`. Subiquity then installs a
    #    MINIMAL system and silently drops the 62 packages this file asks for —
    #    including kubuntu-desktop, sddm and the NVIDIA driver. The install
    #    reports success and boots to a console with no desktop.
    - curtin in-target -- sh -c 'for p in kubuntu-desktop sddm nvidia-driver-570-open; do dpkg -s "$p" >/dev/null 2>&1 || echo "SOVEREIGN WARNING - $p is NOT installed. The installer most likely fell back to an OFFLINE install (no network reached archive.ubuntu.com), so this system has no desktop and no GPU driver. Re-install with a working network." >> /var/log/sovereign-install-warning.log; done'
    #
    # 2. SECURE BOOT ON + an UNSIGNED custom kernel. linux-image-6.12.0 comes
    #    from bindeb-pkg and is not signed by any enrolled key. Ubuntu's shim
    #    chain will refuse it, so the box either falls back to the stock kernel
    #    (losing the whole point of the build) or does not boot at all. Say so
    #    while the operator can still act on it.
    - curtin in-target -- sh -c 'mokutil --sb-state 2>/dev/null | grep -qi "enabled" && echo "SOVEREIGN WARNING - Secure Boot is ENABLED in firmware and the custom kernel 6.12.0 is UNSIGNED (bindeb-pkg output, no enrolled MOK). The signed shim chain will refuse it. Either disable Secure Boot in firmware, or build with secure_boot=signed and enrol the MOK." >> /var/log/sovereign-install-warning.log || true'
    #
    # Check the CUSTOM kernel specifically, not `/lib/modules/*/`. The glob
    # matched ANY kernel, so a module built only for Ubuntu's stock kernel
    # satisfied it — while the box boots 6.12.0, where the module would be
    # absent, nvidia-drm.modeset=1 inert, and the Wayland-only desktop dead.
    # A check that passes on the kernel you do NOT boot is worse than none.
    - curtin in-target -- sh -c 'ls /lib/modules/6.12.0/updates/dkms/nvidia-drm.ko* >/dev/null 2>&1 || ls /lib/modules/6.12.0/kernel/drivers/video/nvidia-drm.ko* >/dev/null 2>&1 || echo "SOVEREIGN WARNING - no nvidia-drm module for kernel 6.12.0 (the one this box boots), so nvidia-drm.modeset=1 will do nothing and there will be no DRM device" >> /var/log/sovereign-install-warning.log'
