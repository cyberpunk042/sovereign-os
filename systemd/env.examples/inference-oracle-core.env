# /etc/sovereign-os/inference-oracle-core.env
# Oracle Core — vLLM + DFlash on RTX PRO 6000 Blackwell (host-resident)
#
# Pick ONE of the operator-named candidates per cmp-ling-26-flash-vs-nemotron-3-nano-omni:
#   - Nemotron-3-Nano-Omni: BF16 native fit; multimodal; up to 1M context
#   - Ling-2.6-flash: 107B MoE; MIT license; needs Q4 or MoE-active-only

ORACLE_MODEL=/mnt/vault/models/nvidia__Nemotron-3-Nano-Omni-30B-A3B-Reasoning-BF16
ORACLE_HOST=127.0.0.1
ORACLE_PORT=8083

# KV-cache dtype: 'auto' on first run; 'fp8' for deep-context profiles
ORACLE_KV_CACHE_DTYPE=fp8

# DFlash speculative-decoding draft (only set when a checkpoint is published
# for the target model on z-lab's HuggingFace org). Boosts code/math 3-6×.
# ORACLE_DFLASH_DRAFT=z-lab/Nemotron-3-Nano-Omni-DFlash

SOVEREIGN_OS_PROFILE=sain-01
SOVEREIGN_OS_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# gpt-oss-120b (MXFP4) — measured 2026-07-28 on the Blackwell tier:
#   199.76 tok/s decode / TTFT 0.036s single-stream (R232 gate)
#   918 tok/s aggregate at 16 concurrent streams (57 tok/s each)
# Swap the three ORACLE_* lines above for these to serve it instead.
# ---------------------------------------------------------------------------
# ORACLE_MODEL=/home/jfortin/models/gpt-oss-120b
# ORACLE_KV_CACHE_DTYPE=auto      # fp8 KV is UNTESTED with MXFP4 weights
#
# When vLLM is installed with `pip --target` (PEP 668 blocks a system install
# and python3-venv may be absent), the unit needs BOTH of these. PATH matters
# because torch shells out to `ninja` to JIT the Marlin MXFP4 kernels, and a
# --target install leaves bin/ninja off PATH — without it the engine dies with
# `FileNotFoundError: 'ninja'`.
# PYTHONPATH=/home/jfortin/vllm-env
# PATH=/home/jfortin/vllm-env/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
#
# The unit runs ProtectSystem=strict with
# ReadWritePaths=/var/log/sovereign-os /var/lib/sovereign-os, and
# ProtectHome=read-only. Reading weights and the vLLM tree out of /home is fine
# (read-only still permits reads), but the JIT caches default to ~/.cache and
# have nowhere writable — redirect them or first start fails:
# XDG_CACHE_HOME=/var/lib/sovereign-os/oracle-cache
# TRITON_CACHE_DIR=/var/lib/sovereign-os/oracle-cache/triton
# TORCHINDUCTOR_CACHE_DIR=/var/lib/sovereign-os/oracle-cache/inductor
# HF_HUB_OFFLINE=1                # weights are local; do not phone home at start
#
# mkdir -p those cache dirs (root-owned, unit runs as root) before first start.
