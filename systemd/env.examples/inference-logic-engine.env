# /etc/sovereign-os/inference-logic-engine.env
# Logic Engine — vLLM (default) or llama.cpp on RTX 3090 (VFIO-bound)
#
# Edit and reload: sudo systemctl restart sovereign-logic-engine.service

SOVEREIGN_OS_LOGIC_BACKEND=vllm
LOGIC_MODEL=/mnt/vault/models/qwen3-coder
LOGIC_HOST=127.0.0.1
LOGIC_PORT=8082

# llama.cpp fallback:
# SOVEREIGN_OS_LOGIC_BACKEND=llama_cpp
# LOGIC_MODEL=/mnt/vault/models/qwen3-coder.Q4_K_M.gguf

SOVEREIGN_OS_PROFILE=sain-01
SOVEREIGN_OS_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Host-resident vLLM on the RTX 5090 (no podman) — measured 2026-07-28 with
# Nemotron-3-Nano-Omni-30B NVFP4: 314.41 tok/s decode, TTFT 0.173s, 30.3/32.6 GB.
# Mirrors how the Oracle Core runs. Use when podman is absent or the container
# image is not built.
# ---------------------------------------------------------------------------
# SOVEREIGN_OS_LOGIC_BACKEND=vllm_host
# LOGIC_MODEL=/home/jfortin/models/Nemotron-3-Nano-Omni-30B-Reasoning-NVFP4
# LOGIC_SERVED_MODEL_NAME=nemotron-nano-omni-30b
# LOGIC_GPU_MEMORY_UTILIZATION=0.90
# LOGIC_MAX_MODEL_LEN=32768
#
# The Omni variant ships custom modeling code, so vLLM needs this. Inspected
# 2026-07-28: 3,976 lines from NVIDIA's official repo, no eval/exec/subprocess/
# pickle.load. One egress path worth knowing — video_io.py fetches a remote .mp4
# when a request passes an http(s) URL as video input. On an air-gap-capable box
# that is user-input-triggered egress; gate it if this tier faces untrusted input.
# LOGIC_TRUST_REMOTE_CODE=1
#
# Pin the tier to the 5090 so it never competes with the Oracle Core on GPU 0.
# CUDA_VISIBLE_DEVICES=1
#
# Same HOME/cache requirement as the Oracle Core: this runs as root under
# ProtectHome=read-only, and FlashInfer writes to HOME/.cache (XDG_CACHE_HOME
# does NOT cover it). Without these, startup dies inside an unrelated import
# chain with: OSError: [Errno 30] Read-only file system: '/root/.cache/flashinfer'
# HOME=/var/lib/sovereign-os/logic-cache
# TRITON_CACHE_DIR=/var/lib/sovereign-os/logic-cache/triton
# TORCHINDUCTOR_CACHE_DIR=/var/lib/sovereign-os/logic-cache/inductor
# PYTHONPATH=/home/jfortin/vllm-env
# PATH=/home/jfortin/vllm-env/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# HF_HUB_OFFLINE=1
