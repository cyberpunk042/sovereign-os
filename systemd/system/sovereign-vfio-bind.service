[Unit]
Description=sovereign-os VFIO GPU binding (one-shot, first boot)
Documentation=https://github.com/cyberpunk042/sovereign-os/blob/main/scripts/hooks/post-install/vfio-bind-4090.sh
ConditionFirstBoot=yes
# SAIN-01 bare-metal hardware setup — skip cleanly on a VM/emulator (no target
# GPU / dual-NIC / ZFS pool to touch). Runs on the real machine (not virtualized).
ConditionVirtualization=no
After=sovereign-friction-audit.service
PartOf=sovereign-firstboot.target

[Service]
Type=oneshot
# BOUNDED START TIMEOUT (2026-07-28). Type=oneshot DISABLES the start
# timeout by default (systemd.service(5)), so leaving this unset means
# INFINITE: a hook that blocks hangs first boot with no failure, no timeout
# and no recovery — the shape that already 'hung a boot at Reached Target
# sovereign-firstboot.target' (2026-07-26). A bound turns an indefinite hang
# into a visible failed unit that the operator can actually see and fix.
# local driver rebind
TimeoutStartSec=120
RemainAfterExit=yes
EnvironmentFile=-/etc/sovereign-os/active-profile.env
ExecStart=/opt/sovereign-os/scripts/hooks/post-install/vfio-bind-4090.sh
# After this runs, reboot is required for vfio-pci to claim the
# device from the initramfs. The service writes a flag the next-boot
# completion service checks.
ExecStartPost=/bin/touch /var/lib/sovereign-os/.vfio-bind-needs-reboot
StandardOutput=journal
StandardError=journal
# Defense-in-depth — writes /etc/modprobe.d for vfio-pci.ids;
# touches /sys/bus/pci/devices/*/driver_override. ProtectSystem=full
# (not strict) because of /sys writes.
# R171 defense-in-depth (Layer 1 lint enforced)
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/etc/modprobe.d /var/lib/sovereign-os
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=sovereign-firstboot.target
