[Unit]
Description=Sovereign Guardian Core eBPF Supervisor (master spec § 10)
Documentation=https://github.com/cyberpunk042/sovereign-os/blob/main/scripts/auditor/guardian-core.py
# Master spec § 10.2 verbatim dependency declaration:
After=tetragon.service
Requires=tetragon.service
# G3 (SDD-998): the unit is ProtectSystem=strict with ReadWritePaths=/mnt/vault/context.
# If /mnt/vault (a ZFS dataset) is not yet mounted when the daemon starts, the
# mount-namespace setup for that ReadWritePaths entry fails → 226/NAMESPACE and a
# Restart=always crash-loop until the pool mounts. Order after the pool + require
# the vault mount so the namespace is always buildable when we run.
After=zfs.target
RequiresMountsFor=/mnt/vault/context
# Transposition-dump OPNsense/Tetragon-dropout prevention (verbatim:
# "must include explicit service binding controls (BindsTo=tetragon.service)"):
# if tetragon stops during a network reconfiguration event, stop with it
# rather than tailing a dead stream — restart re-binds when tetragon returns.
BindsTo=tetragon.service
# Tetragon's JSON export file appears a few seconds AFTER tetragon.service goes
# active, and BindsTo/After gate on the service, not the stream. The default
# start-limit (5 starts / 10s) would latch this unit into `failed` before the
# stream exists — which is exactly what happens on first boot. Disable the limit
# so Restart=always genuinely retries until the Auditor stream is live; the
# ExecStartPre below makes that wait clean instead of a crash-loop.
StartLimitIntervalSec=0

[Service]
Type=simple
# Wait (bounded) for Tetragon's export stream before tailing it, so a slightly
# late file doesn't turn into a crash-loop. Reads /var/run/tetragon (ReadOnlyPaths).
ExecStartPre=/bin/sh -c 'for _ in $(seq 1 60); do [ -e /var/run/tetragon/tetragon.events ] && exit 0; sleep 1; done; echo "guardian: /var/run/tetragon/tetragon.events absent after 60s" >&2; exit 1'
# Master spec § 10.2 verbatim ExecStart:
ExecStart=/usr/local/bin/guardian-core
Restart=always
RestartSec=1
StandardOutput=journal
StandardError=journal

# Defense-in-depth — Guardian only needs read on the tetragon stream
# and append on the security audit log; everything else is read-only.
# R171 defense-in-depth (Layer 1 lint enforced)
ProtectSystem=strict
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
ReadOnlyPaths=/var/run/tetragon
# `-` prefix: tolerate the paths not existing yet at namespace-setup time
# (RequiresMountsFor above guarantees the vault mount is present; the context
# subdir + textfile_collector dir are created on first write). Without the
# prefix a missing dir is a hard 226/NAMESPACE failure.
ReadWritePaths=-/mnt/vault/context -/var/lib/node_exporter/textfile_collector
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# Guardian must be able to invoke `podman kill` — keep CAP_SYS_PTRACE
# off; podman runs in user-namespaces by default and the kill verb does
# not require elevated caps when the container is rootless.

[Install]
WantedBy=multi-user.target
