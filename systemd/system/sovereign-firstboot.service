[Unit]
Description=sovereign-os first-boot completion marker
Documentation=https://github.com/cyberpunk042/sovereign-os/blob/main/docs/src/lifecycle/post-install.md
ConditionFirstBoot=yes
After=sovereign-friction-audit.service sovereign-vfio-bind.service sovereign-network-vlan.service sovereign-tetragon-policy-load.service sovereign-zfs-arc-clamp.service sovereign-nvidia-driver-install.service sovereign-nvidia-driver-bind.service sovereign-workstation-shell-setup.service
# Wants=, NOT Requires= (2026-07-26). These four are HARDWARE-CONDITIONAL and
# each legitimately fails on a box that does not match the SAIN-01 reference
# exactly: tetragon-policy-load exits 1 when tetragon is not installed yet (it
# is downloaded by sovereign-tetragon-install at this same first boot);
# zfs-arc-clamp needs the zfs module, which is late because Debian's zfs units
# Requires= the deprecated systemd-udev-settle; network-vlan exits 1 when the
# profile's NIC layout is not present. With Requires=, ONE of those failing
# meant the completion marker never ran and first boot could never finish —
# the operator's box stalled at "Reached target sovereign-firstboot.target"
# with several units failed. The failures must stay LOUD (each hook emits a
# result="fail" metric and journal error, and the ordering below is unchanged),
# but they must not be able to wedge the boot. `systemctl --failed` remains the
# report; the marker now records that first boot RAN, not that the hardware was
# perfect.
Wants=sovereign-friction-audit.service sovereign-network-vlan.service sovereign-tetragon-policy-load.service sovereign-zfs-arc-clamp.service
PartOf=sovereign-firstboot.target

[Service]
Type=oneshot
# BOUNDED START TIMEOUT (2026-07-28). Type=oneshot DISABLES the start
# timeout by default (systemd.service(5)), so leaving this unset means
# INFINITE: a hook that blocks hangs first boot with no failure, no timeout
# and no recovery — the shape that already 'hung a boot at Reached Target
# sovereign-firstboot.target' (2026-07-26). A bound turns an indefinite hang
# into a visible failed unit that the operator can actually see and fix.
# completion marker — writes a stamp file
TimeoutStartSec=120
RemainAfterExit=yes
ExecStartPre=/bin/mkdir -p /var/lib/sovereign-os
ExecStart=/bin/sh -c 'date -u --iso-8601=seconds > /var/lib/sovereign-os/first-boot-complete'
ExecStartPost=/bin/sh -c 'for f in .vfio-bind-needs-reboot .nvidia-bind-needs-reboot .nvidia-driver-install-needs-reboot; do [ -f "/var/lib/sovereign-os/$f" ] && echo "NOTICE: reboot required for GPU binding to take effect ($f)" > /dev/console; done; true'
StandardOutput=journal
StandardError=journal
# Defense-in-depth — completion marker only writes /var/lib/sovereign-os
# R171 defense-in-depth (Layer 1 lint enforced)
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/var/lib/sovereign-os
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=sovereign-firstboot.target
