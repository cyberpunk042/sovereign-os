[Unit]
Description=sovereign-os Tetragon TracingPolicy load (one-shot, first boot)
Documentation=https://github.com/cyberpunk042/sovereign-os/blob/main/scripts/hooks/post-install/tetragon-policy-load.sh
ConditionFirstBoot=yes
# SAIN-01 bare-metal hardware setup — skip cleanly on a VM/emulator (no target
# GPU / dual-NIC / ZFS pool to touch). Runs on the real machine (not virtualized).
ConditionVirtualization=no
After=tetragon.service zfs.target
Wants=tetragon.service zfs.target
PartOf=sovereign-firstboot.target

[Service]
Type=oneshot
# BOUNDED START TIMEOUT (2026-07-28). Type=oneshot DISABLES the start
# timeout by default (systemd.service(5)), so leaving this unset means
# INFINITE: a hook that blocks hangs first boot with no failure, no timeout
# and no recovery — the shape that already 'hung a boot at Reached Target
# sovereign-firstboot.target' (2026-07-26). A bound turns an indefinite hang
# into a visible failed unit that the operator can actually see and fix.
# loads a local policy file
TimeoutStartSec=120
RemainAfterExit=yes
EnvironmentFile=-/etc/sovereign-os/active-profile.env
ExecStart=/opt/sovereign-os/scripts/hooks/post-install/tetragon-policy-load.sh
StandardOutput=journal
StandardError=journal
# Defense-in-depth — copies policy files to /etc/tetragon; appends to
# /mnt/vault/context security_audit.log on drift.
# R171 defense-in-depth (Layer 1 lint enforced)
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=-/etc/tetragon -/mnt/vault/context /var/lib/sovereign-os
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=sovereign-firstboot.target
