[Unit]
Description=sovereign-os workstation shell defaults (one-shot, first boot)
Documentation=https://github.com/cyberpunk042/sovereign-os/blob/main/scripts/hooks/post-install/workstation-shell-setup.sh
ConditionFirstBoot=yes
PartOf=sovereign-firstboot.target

[Service]
Type=oneshot
# BOUNDED START TIMEOUT (2026-07-28). Type=oneshot DISABLES the start
# timeout by default (systemd.service(5)), so leaving this unset means
# INFINITE: a hook that blocks hangs first boot with no failure, no timeout
# and no recovery — the shape that already 'hung a boot at Reached Target
# sovereign-firstboot.target' (2026-07-26). A bound turns an indefinite hang
# into a visible failed unit that the operator can actually see and fix.
# local dotfile/shell defaults
TimeoutStartSec=300
RemainAfterExit=yes
EnvironmentFile=-/etc/sovereign-os/active-profile.env
ExecStart=/opt/sovereign-os/scripts/hooks/post-install/workstation-shell-setup.sh
StandardOutput=journal
StandardError=journal
# Defense-in-depth — sets /etc/skel + /etc/profile.d defaults
# R171 defense-in-depth (Layer 1 lint enforced)
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/etc/skel /etc/profile.d /etc/bash.bashrc.d /var/lib/sovereign-os
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=sovereign-firstboot.target
